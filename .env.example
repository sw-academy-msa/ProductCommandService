# 로컬 전용 예시입니다. 실 자격증명과 토큰은 기록하지 않습니다.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081
# 일반 DB(5433)와 별도 인스턴스입니다. Product/Order Command 복제본은 같은 Command DB 서버를 사용합니다.
COMMAND_DB_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/product_command
DB_USERNAME=product
DB_PASSWORD=replace-with-your-product-database-password
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=stockdrop-api
ACCOUNT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# JWT 서명 검증과 별개로 기존 판매자 API를 호출해 최신 승인 자격을 확인합니다.
ACCOUNT_INTERNAL_BASE_URL=http://localhost:8080
# 최종 목록 확정 후 쉼표로 구분합니다. 미설정이면 초안은 저장하지만 심사 제출은 차단합니다.
PRODUCT_CATEGORIES=
# 이미지 로컬 저장소: docker compose -f compose.images.yaml up -d
PRODUCT_IMAGES_ENABLED=false
PRODUCT_IMAGES_LOCAL=true
PRODUCT_IMAGES_ENDPOINT=http://localhost:9092
PRODUCT_IMAGES_BUCKET=stockdrop-product-images
PRODUCT_IMAGES_REGION=ap-northeast-2
PRODUCT_IMAGES_MAX_BYTES=10485760

# Kafka 발행은 토픽 준비 후 활성화합니다. Outbox 저장은 비활성 상태에도 수행됩니다.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PRODUCT_OUTBOX_PUBLISHER_ENABLED=false
